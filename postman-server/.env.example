# Copy to .env and fill in. There is no local database — these point at the
# Railway datastores, so `Connect` in the Railway dashboard is where the values
# come from. Use the public URLs here; services deployed on Railway itself use
# the private-network reference syntax (${{Postgres.DATABASE_URL}}) instead.

DATABASE_URL="postgresql://user:password@host:5432/railway"
REDIS_URL="redis://default:password@host:6379"

# Origins allowed to call this API from a browser, comma-separated.
# Defaults to http://localhost:4000 when unset, which is what local dev needs.
# In production this must list the Vercel domain.
CORS_ORIGIN="http://localhost:4000"

# --- Optional: demo-speed knobs, all have defaults ---
# POLL_INTERVAL_MS=1000          # worker poll interval
# SCHEDULER_INTERVAL_MS=60000    # how often scheduled notifications are promoted
# BACKOFF_BASE_SECONDS=30        # first retry delay; doubles each attempt
# MAX_BACKOFF_SECONDS=300        # retry delay ceiling
# WORKER_ID=worker-1             # distinct per worker process
# HEALTH_PROBE_TIMEOUT_MS=2000   # /health dependency probe timeout
