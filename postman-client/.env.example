# Copy to .env.local and adjust if your API is not on the default port.
#
# NEXT_PUBLIC_ values are inlined into the browser bundle by `next build`, not
# read at runtime — changing this in Vercel requires a redeploy to take effect.
# The API's CORS_ORIGIN must allow whatever origin serves this app.

NEXT_PUBLIC_API_URL="http://localhost:3000"

# Dashboard poll interval. Polling pauses while the tab is hidden.
# NEXT_PUBLIC_POLL_INTERVAL_MS=1000
